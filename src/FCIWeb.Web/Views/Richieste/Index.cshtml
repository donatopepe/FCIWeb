@model PagedResult<Richiesta>
@{
    ViewData["Title"] = "Richieste";
}

<div class="page-head">
    <h1>Richieste</h1>
    <div>
        <a class="button" asp-action="ExportCsv" asp-route-q="@ViewBag.Query">Esporta CSV</a>
        <a class="button" asp-action="Create">Nuova richiesta</a>
    </div>
</div>

<form method="get" asp-action="Index" class="filters">
    <input type="text" name="q" value="@ViewBag.Query" placeholder="Cerca per NDG, intestazione o UO" />
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <button type="submit">Cerca</button>
    <a class="linklike" asp-action="Index">Azzera</a>
</form>

@if (Model.Items.Count == 0)
{
    <p class="empty">Nessuna richiesta trovata.</p>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>NDG</th>
                <th>Intestazione</th>
                <th>UO</th>
                <th>Stato</th>
                <th>Data</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td>@r.NDG</td>
                    <td>@r.Intestazione</td>
                    <td>@r.UOCode</td>
                    <td><span class="badge badge-@r.Stato.ToString().ToLowerInvariant()">@r.Stato</span></td>
                    <td>@r.DataCreazione.ToString("yyyy-MM-dd HH:mm")</td>
                    <td><a asp-action="Details" asp-route-id="@r.Id">Dettagli</a></td>
                </tr>
            }
        </tbody>
    </table>

    <nav class="pager" aria-label="Paginazione richieste">
        <span>Pagina @Model.PageNumber di @Model.TotalPages — @Model.TotalCount risultati</span>
        <div>
            @if (Model.HasPreviousPage)
            {
                <a class="button" asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-page="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize" rel="prev">Precedente</a>
            }
            @if (Model.HasNextPage)
            {
                <a class="button" asp-action="Index" asp-route-q="@ViewBag.Query" asp-route-page="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize" rel="next">Successiva</a>
            }
        </div>
    </nav>
}
