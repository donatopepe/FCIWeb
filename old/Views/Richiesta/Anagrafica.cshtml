<script type="text/javascript">
    $(function () {
        var False = false;
        var True = true;
        function ControlloPersona(value) {
            //console.log(value);
            if (value) {
                //$('.persona').css("visibility", "visible"); //show
                $('.persona').show(); //show
                $('.giuridica').hide(); //hide
                //console.log("show "+value);
            }
            else {
                //$('.persona').css("visibility", "hidden"); //hide
                $('.persona').hide(); //hide
                $('.giuridica').show(); //show
                //console.log("hide " +value);

            }
        };
