<fieldset>
    <legend>Canale di consegna</legend>
    <table>
        <tr>
            <td>
                <div class="form-group">
                @Html.LabelFor(model => model.CanaleConsegna, htmlAttributes: new { @class = "control-label col-md-2" })
                <div>
                    @Html.DropDownListFor(model => model.CanaleConsegna.Id, (IEnumerable<SelectListItem>)ViewBag.DropDownConsegna, "-- Seleziona --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.CanaleConsegna, "", new { @class = "text-danger" })
                </div>
                </div>
            </td>
            <td>
                @Html.HiddenFor(model => model.FilialeConsegna)
                <div class="Filialeconsegna form-group">
                    @Html.LabelFor(model => model.FilialeConsegna, htmlAttributes: new {@class = "control-label col-md-2"})
                    <div class="col-md-10">
                        @Html.Editor("FilialeConsegnaDesc", new {htmlAttributes = new {@class = "form-control"}})
                        @Html.ValidationMessageFor(model => model.FilialeConsegna, "", new {@class = "text-danger"})
                    </div>
                </div>

                <div class="email form-group">
                    @Html.LabelFor(model => model.email, htmlAttributes: new {@class = "control-label col-md-2"})
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.email, new {htmlAttributes = new {@class = "form-control"}})
                        @Html.ValidationMessageFor(model => model.email, "", new {@class = "text-danger"})
                    </div>
                </div>

                <div class="pec form-group">
                    @Html.LabelFor(model => model.pec, htmlAttributes: new {@class = "control-label col-md-2"})
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.pec, new {htmlAttributes = new {@class = "form-control"}})
                        @Html.ValidationMessageFor(model => model.pec, "", new {@class = "text-danger"})
                    </div>
                </div>
            </td>
        </tr>
    </table>
    

    
</fieldset>

<script type="text/javascript">

            $("document").ready(function () {


    var myArrayParametriRichiestaConsegna = [];
    @foreach(var item in ViewBag.ParametriRichiestaConsegna)
    {
        @:myArrayParametriRichiestaConsegna.push({ Richiesta: "@Html.Raw(item.Richiesta.Id)", Consegna: "@Html.Raw(item.Consegna.Id)"});
    }
                var stato = "@Model.Stato.Stato";
                var CanaleRicezione = $("select#CanaleRicezione_Id");
                var CanalePagamento = $("select#ModalitaPagamento_Id");
                var CanaleConsegna = $("select#CanaleConsegna_Id");


                
                var datepicker = $("#DataRichiesta").data("kendoDatePicker");
                datepicker.bind("change", function () {
                    var value = this.value();
                    /* The result can be observed in the DevTools(F12) console of the browser. */
                    //alert.log(value); //value is the selected date in the datepicker

                    //alert("datanuova: " + value);
                    DataEvasione();
                });

                DataEvasione();
                function DataEvasione(value) {
                    var richiesta = $("#DataRichiesta").val();
                    
                    var dateString = richiesta; // Oct 23
                    var words = dateString.split('/');

                    var dd = words[0];
                    var mm = words[1];
                    var y = words[2];
                    var dateObject = new Date(mm + '/' + dd + '/' + y);
                    //alert("dopo split " + dateObject.toLocaleDateString())

                    var numberOfDaysToAdd = 90;//evasione 90gg
                    dateObject.setDate(dateObject.getDate() + numberOfDaysToAdd);
                    //alert("add day " + dateObject.toLocaleDateString())
                    $("#datamaxevasione").text(dateObject.toLocaleDateString());

                    //var dd = String(dateObject.getDate()).padStart(2, '0');
                    //var mm = String(dateObject.getMonth() + 1).padStart(2, '0');;

                    var lung = String(dateObject.getDate()).length;
                    var dd = ("00" + String(dateObject.getDate())).substring(lung);

                    lung = String(dateObject.getMonth()).length;;
                    var mm = ("00" + String(dateObject.getMonth() + 1)).substring(lung);

                    var y = dateObject.getFullYear();
                    $("#datamaxevasione").text(dd + '/' + mm + '/' + y);
                }

            function ControlloPagamento(value) {
                console.log(value);
                if (value) {
                    console.log(value);
                    $('.numeroconto').show(); //show

                } else {
                    console.log(value);
                    $('.numeroconto').hide(); //hide
                }

            };


                CanalePagamento.change(function () {
                    $('#NumeroConto').val("");

                ControlloPagamento(CanalePagamento.val() == "@ViewBag.CanaleFilialeID");
            });



            function ControlloConsegna(value) {
            console.log("ControlloConsegna:"+value);
            if (value == "@ViewBag.CanalePecID") {
                console.log(value);
                $('.pec').show(); //show
                $('.email').hide(); //hide
                $('.Filialeconsegna').hide(); //hide
                CanaleConsegna.val("@ViewBag.CanalePecID");
            } else {
                if (value == "@ViewBag.CanaleEmailID") {
                    console.log(value);
                    $('.pec').hide(); //show
                    $('.email').show(); //hide
                    $('.Filialeconsegna').hide(); //hide
                    CanaleConsegna.val("@ViewBag.CanaleEmailID");
                }
                else {
                    if (value == "@ViewBag.CanaleFilialeID") {
                        console.log(value);
                        $('.pec').hide(); //hide
                        $('.email').hide(); //show
                        $('.Filialeconsegna').show(); //hide
                        CanaleConsegna.val("@ViewBag.CanaleFilialeID");
                    } else {
                        if ((value == "@ViewBag.CanaleRaccomandataID") || (value == "") || (value == null)) {
                            console.log(value);
                            $('.pec').hide(); //hide
                            $('.email').hide(); //show
                            $('.Filialeconsegna').hide(); //hide
                            if (value == "@ViewBag.CanaleRaccomandataID") {
                                CanaleConsegna.val("@ViewBag.CanaleRaccomandataID");
                            }

                        }

                    }
                }
            }

            };



                CanaleConsegna.unbind().change(function () {
                    $('#Filiale').val("");
                    $('#pec').val("");
                    $('#email').val("");
            console.log("click selezione");
            var valore = CanaleConsegna.val();
            console.log("|" + valore + "|");
            ControlloConsegna(valore);
        });
            function FiltraConsegna(attuale, Richiesta, Consegna) {

            if (attuale == Richiesta) {
                console.log("FiltraConsegna:" + attuale + " " + Richiesta + " " + Consegna);
                $('#CanaleConsegna_Id option[value="' + Consegna+'"]').removeAttr('disabled'); //show
                //$('#CanaleConsegna_Id').val(Consegna);
                //$('#CanaleConsegna_Id').value = Consegna;
            }
        }
            function ControlloCanaleRicezione(stato,value) {
            console.log(value);
            if (stato == "Inizio") {
                if (value == "@ViewBag.CanaleFilialeID") {
                    $('.modalitapagamento').show(); //show
                }
                else {
                    $('.modalitapagamento').hide(); //show
                }
            }


                $('#CanaleConsegna_Id option').attr('disabled', 'disabled');
                $('#CanaleConsegna_Id option[value=""]').removeAttr('disabled');

            //myArrayParametriRichiestaConsegna.forEach(element => FiltraConsegna(value, element.Richiesta, element.Consegna));
            //console.log(myArrayParametriRichiestaConsegna);
            for (var i in myArrayParametriRichiestaConsegna) {
                FiltraConsegna(value, myArrayParametriRichiestaConsegna[i].Richiesta, myArrayParametriRichiestaConsegna[i].Consegna);
            };
            ControlloConsegna(CanaleConsegna.val());
                };






        CanaleRicezione.unbind().change(function () {
            console.log("Stato " + stato + " CanaleRicezione " + $("select#CanaleRicezione_Id option:selected").val());
            CanaleConsegna.val("");
            CanaleConsegna.value = "";
            ControlloCanaleRicezione(stato, $("select#CanaleRicezione_Id option:selected").val());
        });

                @*@if (@Model.CanaleRicezione!=null)
                {
                    @:CanaleRicezione.val('@Model.CanaleRicezione.Id');
                }
                @if (@Model.CanaleConsegna!= null) {
                    @:CanaleConsegna.val('@Model.CanaleConsegna.Id');
                }
                @if (@Model.ModalitaPagamento!= null) {
                    @:CanalePagamento.val('@Model.ModalitaPagamento.Id');
                }*@


                ControlloCanaleRicezione(stato, CanaleRicezione.val());
                ControlloConsegna(CanaleConsegna.val());
                ControlloPagamento(CanalePagamento.val() == "@ViewBag.CanaleFilialeID");



    });
</script>


