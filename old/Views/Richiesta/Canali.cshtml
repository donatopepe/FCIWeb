<script>
  $(function() {
    function log( message ) {
      $( "<div>" ).text( message ).prependTo( "#log" );
      $( "#log" ).scrollTop( 0 );
    }

      $("#FilialeConsegnaDesc").autocomplete({
        source: function(request, response) {
            var url = '@Url.Action("GetFiliali", "Richiesta")';
            $.ajax({
                url: url,
                type: "POST",
                dataType: "json",
                data: {
                    prefix: request.term
                },
                success: function(data) {
                    response($.map(data,
                        function(item) {
                            //console.log("item di ritorno");
                            //console.log(item);
                            return { label: item.DescrizioneUO, value: item.UOCode +' - '+ item.DescrizioneUO, id: item.UOCode };
                        }))
                }
            });
        },
        minLength: 3,
        select: function(e, ui) {

            if ((ui.item)) {
                console.log("ui.item", ui.item);
                $("#FilialeConsegna").val(ui.item.id);
            }

            //console.log("value ", $(this).val());
        },
        change: function(e, ui) {
            if (!(ui.item)) {e.target.value = "";}
        },
        open: function() {
            $(this).removeClass("ui-corner-all").addClass("ui-corner-top");
        },
        close: function() {
            $(this).removeClass("ui-corner-top").addClass("ui-corner-all");
        }
      }).val('@ViewData["FilialeC"]');
  });
</script>