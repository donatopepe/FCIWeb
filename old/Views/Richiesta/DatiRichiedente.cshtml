@model RCDWeb.Areas.RCD.Models.GestioneViewModel
    <table>
        <tr>
            <td>
                <div class="TipoRichiedente form-group">
                    @Html.LabelFor(model => model.TipoRichiedente, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        <div class="checkbox">
                            @Html.DropDownListFor(model => model.TipoRichiedente.Id, (IEnumerable<SelectListItem>)ViewBag.DropDownTipoRichiedente, "-- Seleziona --", new { @class = "form-control" })
                            @*@Html.EditorFor(model => model.TipoRichiedente)*@
                            @Html.ValidationMessageFor(model => model.TipoRichiedente, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </td>
            <td>
                <div class="form-group">
                    @Html.LabelFor(model => model.Richiedente, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Richiedente, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Richiedente, "", new { @class = "text-danger" })
                    </div>
                </div>
            </td>
        </tr>
    </table>

 


<div class="legittimato2 form-group">
    @*@Html.LabelFor(model => model.Legittimato, htmlAttributes: new { @class = "control-label col-md-2" })*@
    <div class="col-md-10">
        <div class="checkbox">
            @if (Model.Legittimato == null)
            {
                <p>Legittimato Non selezionato</p>
            }
            else
            {
                if ((bool)Model.Legittimato)
                {
                    
                    <p>Legittimato</p>
                }
                else
                {
                    
                    <p>Non Legittimato</p>
                }
            }
            @Html.ValidationMessageFor(model => model.Legittimato, "", new { @class = "text-danger" })
        </div>
    </div>
</div>
