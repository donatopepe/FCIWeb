<fieldset class="inoltro">
    <legend>Inoltro a UO Competente</legend>
    <div>
        <div class="form-group">
            @Html.LabelFor(model => model.UOCode_Inoltro, htmlAttributes: new { @class = "control-label col-md-2" })
            <div>
                @Html.DropDownListFor(model => model.UOCode_Inoltro, (IEnumerable<SelectListItem>)ViewBag.DropDownUffici, "-- Seleziona --", new { @class = "form-control" })
                @*@Html.EditorFor(model => model.UOCode_Inoltro, new { htmlAttributes = new { @class = "form-control" } })*@
                @Html.ValidationMessageFor(model => model.UOCode_Inoltro, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
</fieldset>

<script type="text/javascript">
    $(function () {

        var TipoRichiedente = $("select#TipoRichiedente_Id");
        var Cessione = $("select#Cessione");
        var Legittimato = $("select#Legittimato");

        function ControlloTitolare(value) {
            if (value) {
                $('.legittimato').show(); //show

            }
            else {
                $('.legittimato').hide();
                $('.cessione').hide();
                Cessione.val("");
                Cessione.value = "";
                Legittimato.val("");
                Legittimato.value = "";
            }
        };
        ControlloTitolare(TipoRichiedente.val() != "@ViewBag.CuratoreId");
        TipoRichiedente.change(function () {
            $('#UOCode_Inoltro').val("").change();
            ControlloTitolare($(this).val() != "@ViewBag.CuratoreId");
            ControlloUOCompetente(TipoRichiedente.val() == "@ViewBag.CuratoreId" || Cessione.val() == "True");
        });


        function ControlloLegittimato(value) {
            //console.log(value);
            if (value) {
                $('.cessione').show(); //show
            }
            else {
                $('.cessione').hide(); //show
                Cessione.val("");
                Cessione.value = "";
            }
        };
        ControlloLegittimato(Legittimato.val() == "True");
        Legittimato.change(function () {
            ControlloLegittimato($(this).val() == "True");
        });

        function ControlloUOCompetente(value) {
            //console.log(value);
            if (value) {
                $('.inoltro').show(); //show
            }
            else {
                $('.inoltro').hide(); //show
            }
        };
        ControlloUOCompetente(TipoRichiedente.val() == "@ViewBag.CuratoreId" || Cessione.val() == "True");
        Cessione.change(function () {
            $('#UOCode_Inoltro').val("").change();
            ControlloUOCompetente(TipoRichiedente.val() == "@ViewBag.CuratoreId" || Cessione.val() == "True");
        });
    });

</script>
