    function GestioneNuova() {
        var url = '@Url.Action("Gestione", "Richiesta")';
        dato = {};
        console.log(dato);
        $.ajax({
        url: url,
        data: dato,
        type: "GET",
        error: function (xhr) {
        alert('Error: ' + xhr.statusText);
        },
        success: function (result) {
        console.log("Popolo div dettaglio");

        $('#dettaglio').html(result);

        }
        });
        }
</script>


<p>
