    function confirmScelta(msg, divIdDialog, istituto, ndg, cf) {

        setConfirmDialogText(msg, "confirmDialog");

        $("#" + divIdDialog).dialog({
            resizable: false,
            height: 250,
            width: 370,
            modal: true,
            buttons: {
                Ok: function () {
                    $(this).dialog("close");
                    $(this).dialog("destroy");
                    @*var url = '@Url.Action("Gestione", "Richiesta")';
                    url += '?istituto=' + istituto + '&amp;ndg=' + ndg;
                    location.href = url;*@
                    $.ajax({
                        type: 'post', //get

                        url: '@Url.Action("Gestione", "Richiesta")',
                        data: { istituto:istituto, ndg: ndg,codfiscale:cf },
                        cache: false,
                        beforeSend: function (jqXHR, settings) {

                        },
                        error: function (jqXHR, textStatus, errorThrown) {
                            alert('errore: ' + textStatus + ' \n desc: ' + errorThrown);
                        },
                        success: function (data, textStatus, jqXHR) {
                            $("#loading").css("display", "none");
                            //inserisce la response nel DOM specificato
                            $('#sceltaNdg').show();
                            $("#sceltaNdg").html(data);

                            @*CallTracciatoGarante('@string.Concat("example\\\\", myProfile.UserInfo.Matricola)',
                                'CNZ',
                                "",
                                "",
                                ndg,
                                'RICR_SOC',
                                'Portal',
                                '@Session.SessionID',
                                '',
                                ''
                            );*@

                            setTimeout(function() {
                                var targetOffset = $('#anchorScelta').offset().top;
                                $('html,body').animate({ scrollTop: targetOffset }, 1000);
                            }, 500);
                        },
                        complete: function (jqXHR, textStatus) {
                        }
                    });
                },
                Annulla: function () {
                    $(this).dialog("close");
                    $(this).dialog("destroy");
                }
            }
        });
    }

    @*function checkCNZNdg(istituto,ndg,cf) {
