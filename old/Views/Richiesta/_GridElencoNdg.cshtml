    function getCfNdg(istituto,ndg) {
        var desc = "";
        $.ajax({
            url: '@Url.Action("getCfNdg", "Ndg")',
            type: 'POST',
            async: false,
            dataType: 'json',
            data: { istituto: istituto, ndg: ndg },
            cache: false,
            error: function(jqXHR, textStatus, errorThrown) {
                alert('errore: ' + textStatus + ' \n desc: ' + errorThrown);
            },
            success: function(data) {
                desc = data;
            }
        });
        return desc;
    }

    function GridElencoNdg_OnRowSelect(e) {
        var entityGrid = $("#GridElencoNDG").data("kendoGrid");
        var dataItem = entityGrid.dataItem(entityGrid.select());


        if (dataItem.ndg != -1) {
            sceltaNdg(@istituto, dataItem.ndg, dataItem.codiceFiscale);
        }
    }


    function GridElencoNdg_OnDataBound(e) {
        $("#GridElencoNDG").find('.k-no-data td').text('Loading...');

        var grid = $("#GridElencoNDG").data("kendoGrid");

        if (grid.dataSource.total() == 1) {
            //verifico se l'unico record contiene il codice di errore specificato nella GridAction
            var ndg = grid._data[0].ndg;
            var ist =@istituto;
            var cf =grid._data[0].codiceFiscale;
            var msg = grid._data[0].intestazione;

            if (ndg == -1) {
                //svuoto l'oggetto grid e visualizzo il messaggio di errore
                grid.total = 0;
                //grid.dataBind(Array());
                $("#GridElencoNDG").find('.k-no-data td').text(msg);
            } else {
                sceltaNdg(ist,ndg,cf);
            }
        }

    }
</script>

<div>
    <fieldset>
        <legend>Elenco NDG</legend>

        <div>

            @(Html.Kendo().Grid<GridElencoNDGModel>()
                .Name("GridElencoNDG")
                .Columns(columns =>
                {
                    columns.Bound(o => o.ndg).Width(100);
                    columns.Bound(o => o.intestazione).Width(350);
                    columns.Bound(o => o.natura_giuridica).Width(50);
                    //columns.Bound(o => o.numRappDiretti).Width(50);
                    //columns.Bound(o => o.numRappIndiretti).Width(50);
                    columns.Bound(o => o.dataNascita).Format("{0:dd/MM/yyyy}").Width(80);
                    columns.Bound(o => o.codiceFiscale).Width(50);
                    columns.Bound(o => o.indirizzoResidenza).Width(350);
                })
                .DataSource(dataSource =>
                    dataSource.Ajax()
                          //.Events(events => events.Error("Grid_onError"))
                          .Read(read => read.Action("_GridElencoNdgBinding", "Richiesta", Model))
                )
                .Selectable()
                .Events(events => events.DataBound("GridElencoNdg_OnDataBound").Change("GridElencoNdg_OnRowSelect"))
                .Resizable(resize => resize.Columns(true))
                .Scrollable(scrolling => scrolling.Enabled(true))
                .Sortable(sorting => sorting.Enabled(true))
                .Pageable(paging => paging.Enabled(true).Messages(m => m
                    .Display("{0} - {1} di {2} elementi")
                    .Empty("Nessun elemento trovato"))))
        </div>

    </fieldset>
</div>
