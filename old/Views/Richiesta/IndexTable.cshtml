@model IEnumerable<RCDWeb.Areas.RCD.Models.Richieste>

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.DataRichiesta)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NDG)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Richiedente)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataAvviso)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataIIAvviso)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataConsegna)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DataChiusa)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Filiale)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Luogo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Matricola)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UltimaModifica)
        </th>
        <th></th>
        <th></th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DataRichiesta)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NDG)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Richiedente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataAvviso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataIIAvviso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataConsegna)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataChiusa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Filiale)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Luogo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Matricola)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UltimaModifica)
            </td>
            <td>
                @if (item.UOCodeNext == ViewBag.MioUocode)
                {
                    using (Html.BeginForm("Gestione", "Richiesta", new { id = item.Id }, FormMethod.Get, null))
                    {
                        <div class="form-actions no-color">
                            <input type="submit" value="Gestione" class="btn btn-default" />
                        </div>
                    }
                }
            </td>
            <td>
                @using (Html.BeginForm("Details", "Richiesta", new { }, FormMethod.Post, null))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-actions no-color">
                        @Html.Hidden("Id", item.Id, new { id = item.Id })
                        <input type="submit" value="Dettagli" class="btn btn-default" />
                    </div>
                }
            </td>
            <td>
                @if ((item.Stato != null) && (item.Stato.Stato == "Inizio"))
                {
                    using (Html.BeginForm("Delete", "Richiesta", new { }, FormMethod.Post, null))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-actions no-color">
                            @Html.Hidden("Id", item.Id, new { id = item.Id })
                            <input type="submit" value="Cancella" class="btn btn-default" />
                        </div>
                    }
                }

            </td>
        </tr>
    }

</table>
