  function controlloDate() {
    var dataOrdineDA = "dataOrdineDA";
    var dataOrdineDAValue = $('#dataOrdineDA').val();

    var dataOrdineAValue = $('#dataOrdineA').val();
    var esito = true;
    if (new Date(dataOrdineDAValue).getTime() > new Date(dataOrdineAValue).getTime()) {
      esito = false;
    }
    if (esito == false) {
      alertDialog('Inserire un intervallo valido', 'confirmDialogFiltri', dataOrdineDA);
    }
    return esito;
  }

  function loadFrame(file) {
      try {
          if (file != "") {
          $("iframe[id=pdfView]").attr('src', file);
            }
      var loaded = document.getElementById('pdfView').contentWindow.document.getElementsByTagName("embed")[0]!= null || document.getElementById('pdfView').contentWindow.document.getElementsByTagName("object")[0] != null;
          if (loaded) {
              $('.ui-dialog-buttonset button:contains("Close")').button().show();
              $("#loading").css("display", "none");
          } else {
              setTimeout(function () {
                  loadFrame("");
              }, 10000);
                
          }
      }
      catch(err) {
          if (err.message.indexOf("Interfaccia non supportata") > -1 || err.message.indexOf("No such interface supported") > -1) {
              $('.ui-dialog-buttonset button:contains("Close")').button().show();
              $("#loading").css("display", "none");
          }
      }

      
  }
  
  function dialogOpenPdf(divId, protocollo,idModello) {
      if ($('#anchorFiltri').offset() != undefined) {
      var targetOffset = $('#anchorFiltri').offset().top-150;
      $('html,body').animate({ scrollTop: targetOffset }, 0);
      }
      $("#loading").css("display", "block");

    $("#" + divId).dialog({
      width: 800,
      height: 500,
      resizable: false,
      modal: true,
      complete: function(data, textStatus, jqXHR) {
          $("#loading").css("display", "none");
      },
      success: function(data, textStatus, jqXHR) {
          $("#loading").css("display", "none");
      },
      open: function() {
          $(".ui-dialog-titlebar-close").hide();
          $('.ui-dialog-buttonset button:contains("Close")').button().hide();
         
          var url = "@(Html.Raw(Url.Action("OpenPDF", "Richiesta", new
                                 {
                                     protocollo = "-1",
                                     idModello = "__idModello__"
                                    
                                 })))";


          var url1 = url.replace("-1", protocollo);

          var urlPDF = url1.replace("__idModello__", idModello);

          var directoryFile = '@Url.Content("urlPDF")';
         
        var file = directoryFile.replace("urlPDF", urlPDF);
        
        //$("iframe[id=pdfView]").attr('src', file);
          loadFrame(file);

      },
      buttons: {
        "Close": function () {
          $(this).dialog("close");
          $(this).dialog("destroy");
          $("#loading").css("display", "none");
          $.ajax({
            url: '@Url.Action("DeleteTempPDF", "Richiesta")',
            type: 'POST',
            dataType: 'text',
            cache: true,
            data: { protocollo: protocollo,idModello: idModello }
          });
        }
      }
    });
  }

