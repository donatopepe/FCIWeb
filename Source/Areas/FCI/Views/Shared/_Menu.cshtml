

@using AreaCommonWeb.Models

@model List<VoceMenu>

@(
 
Html.Kendo().Menu()
.Name("MainMenu")
.Items(menu =>
{
    foreach (VoceMenu m1 in Model)
    {
		if (m1.SottoMenu != null) {
			// MenuItem has ChildItems             
			
			menu.Add().Text(m1.Text).Items(menu2 =>
			{
				foreach (VoceMenu m2 in m1.SottoMenu) {
					if (m2.SottoMenu != null) {
						// MenuItem has ChildItems                              
						
						menu2.Add().Text(m2.Text).Items(menu3 =>
						{
							// Third level MenuItems is not allowed to have children.        
							foreach (VoceMenu m3 in m2.SottoMenu) {
                                if (m3.ActionName == null)
                                {
                                    menu3.Add().Text(m3.Text);
                                }
                                else {
                                    if (m3.RouteName == null)
                                    {
                                        menu3.Add().Text(m3.Text).Action(m3.ActionName, m3.ControllerName);
                                    }
                                    else
                                    {
                                        menu3.Add().Text(m3.Text).Action(m3.ActionName, m3.ControllerName, new RouteValueDictionary(new Dictionary<string, object> { { "RN", m3.RouteName }, { "RV", m3.RouteValue } }));
                                    }
                                }
                            }
                        });
					} else {
						// MenuItem has no ChildItems         
                        if (m2.ActionName == null)
                        {
                            menu2.Add().Text(m2.Text);
                        }
                        else
                        {
                            if (m2.RouteName == null)
                            {
                                menu2.Add().Text(m2.Text).Action(m2.ActionName, m2.ControllerName);
                            }
                            else
                            {
                                menu2.Add().Text(m2.Text).Action(m2.ActionName, m2.ControllerName, new RouteValueDictionary(new Dictionary<string, object> {{"RN", m2.RouteName}, {"RV", m2.RouteValue}}));
                            }
                        }
                    }
				}
			});
		} else {
			// MenuItem has no ChildItems 
            if (m1.ActionName == null)
            {
                menu.Add().Text(m1.Text);
            }
            else
            {
                if (m1.RouteName == null)
                {
                    menu.Add().Text(m1.Text).Action(m1.ActionName, m1.ControllerName);
                }
                else
                {
                    menu.Add().Text(m1.Text).Action(m1.ActionName, m1.ControllerName, new RouteValueDictionary(new Dictionary<string, object> {{"RN", m1.RouteName}, {"RV", m1.RouteValue}}));
                }
            }
        }
	}
})
 
 
) 

