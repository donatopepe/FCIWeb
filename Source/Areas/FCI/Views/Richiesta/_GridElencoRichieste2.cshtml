<style>
    table.TabellaRCD {
        width: 100%;
        text-align: left;
        border-collapse: collapse;
    }

        table.TabellaRCD td, table.TabellaRCD th {
            border: 1px solid #AAAAAA;
        }

        table.TabellaRCD tr:nth-child(even) {
            background: #EEECEC;
        }

        table.TabellaRCD thead {
            background: #EEECEC;
        }

