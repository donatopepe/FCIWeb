                    return type == 'text';
                }




                self.colonne = ko.observableArray([
                    //new ColonnaConfigurazione("Steve", self.tipoAvviabili.filter(function (x) {return x.type === 'text'})[0]),
                    //new ColonnaConfigurazione("Bert", self.tipoAvviabili.filter(function (x) {return x.type === 'dropdown'})[0])
                ]);

