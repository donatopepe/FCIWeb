                <script>
                function AppViewModel() {
                    var url = "@Url.Action("getFoglio", "Richiesta")";
                    var data = {
                            guid: guid,
                    };
                    this.loggedValues = ko.observableArray();
                    var rowversionFoglio;

                    var self = this;
                    this.NomeLista = ko.observable();
                    this.NomeListaPrec;
                    this.getDati = function () {
                        $.getJSON(url, data, function (allData) {
                            self.NomeLista(allData.NomeLista);
                            self.NomeListaPrec = self.NomeLista();
                            self.rowversionFoglio = allData.RowVersion;
                            console.log("allData:" + JSON.stringify(allData));
                            console.log("Nome lista:" + JSON.stringify(self.NomeLista()));
                            console.log("rowversionFoglio:" + JSON.stringify(self.rowversionFoglio));
                        });
                    };
                    this.getDati();
                    this.NomeListaDelay = ko.pureComputed(this.NomeLista)
                        .extend({ rateLimit: { method: "notifyWhenChangesStop", timeout: 500 } })
                        .subscribe(function (val) {
                            console.log("Nome lista:" + JSON.stringify(self.NomeLista()));
                            console.log("Nome lista Prec:" + JSON.stringify(self.NomeListaPrec));
                            if (val !== '' && self.NomeListaPrec != self.NomeLista()) {
                            var url = "@Url.Action("UpdateFoglio", "Richiesta")";
                            var data = {
                                 guid: guid,
                                NomeLista: val,
                                rowversion: self.rowversionFoglio,
                            };
                            $.post(url, data, function (dato) {
                                console.log("UpdateFoglio:"+JSON.stringify(dato));
/*                                self.loggedValues.push(JSON.stringify(dato));*/
                                guid = dato.guid;
                                var result = dato.result;
                                if (result > 0) {
                                    self.getDati();
                                    alert('Aggiornamento non completato, dati foglio ricaricati perchè modificato da altro utente.');
                                }
                            });
                        }
                    }, this);
                }

                // Activates knockout.js
                ko.applyBindings(new AppViewModel(), document.getElementById("GestoreFoglio"));
                </script>
            </legend>
        }
