                var self = this;

                // Non-editable catalog data - would come from the server
                self.tipoAvviabili = [
                    { nomeTipo: "Testo", type: 'text' },
                    { nomeTipo: "Selettore", type: 'autocomplete', source: 'No,Si' },
                    { nomeTipo: "Calendario", type: 'calendar' },
                    { nomeTipo: "Numero", type: 'number' },
                    { nomeTipo: "Casella di controllo", type: 'checkbox' },
                    { nomeTipo: "Sola lettura", type: 'readOnly' },
                ];

                self.statiAvviabili = ko.observableArray([
                    //{ Nome:"Bozze", Descrizione:"Bozze" },
                    //{ Nome:"Annullata", Descrizione:"Annullata" },
                    //{ Nome:"Pubblicata", Descrizione:"Pubblicata" },
                    //{ Nome:"Archiviata", Descrizione:"Archiviata" },
                    //{ Nome:"Nascosta", Descrizione:"Nascosta" },
                ]);

                self.stato = ko.observable();

                self.cancellabile = ko.observable()
                var statoPrec;
                this.getStato = function () {
                    var url = "@Url.Action("getFoglio", "Richiesta")";
                    var data = {
                            guid: guid,
                    };
                    $.getJSON(url, data, function (allData) {
/*                        console.log("getStato: " + JSON.stringify(allData));*/
                        self.statiAvviabili.removeAll();
                        allData.stati.forEach(function (e) {
                            console.log("statoAvviabile:" + JSON.stringify(e));
                            self.statiAvviabili.push(e);
                        });
                        console.log("statiAvviabili:" + JSON.stringify(self.statiAvviabili()));


                        self.rowversionFoglio = allData.RowVersion;
                        var nomestato = allData.stato.Nome;
                        var statoavviabile = self.statiAvviabili().filter(function (x) { return x.Nome === nomestato })[0];
                        self.stato(statoavviabile);
                        self.statoPrec = self.stato();
                        console.log("statoPrec:" + JSON.stringify(self.statoPrec));
                        console.log("stato:" + nomestato+"=" + JSON.stringify(self.stato()));
                        console.log("rowversionFoglio:" + JSON.stringify(self.rowversionFoglio));
                        console.log("cancellabile:" + nomestato + "=" + JSON.stringify(self.stato().Cancellabile));
                        self.cancellabile(self.stato().Cancellabile);

                    });
                };
                this.getStato();
                this.statoDelay = ko.pureComputed(this.stato)
                        .extend({ rateLimit: { method: "notifyWhenChangesStop", timeout: 500 } })
                    .subscribe(function (val) {
                        console.log("val:" + JSON.stringify(val));
                        console.log("stato:" + JSON.stringify(self.stato()));
                        console.log("statoPrec:" + JSON.stringify(self.statoPrec));

                        if (val !== '' && self.statoPrec && self.stato() && self.statoPrec.Nome && self.stato().Nome && self.statoPrec.Nome != self.stato().Nome) {
                            console.log(JSON.stringify(val));

