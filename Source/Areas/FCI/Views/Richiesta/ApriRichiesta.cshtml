    var table;
    var url = "@Url.Action("Lista", "Richiesta")";

    function updateColonne(obj) {
        // Number of columns
        var size = obj.options.columns.length;

        if (obj.options.data && typeof (obj.options.data[0]) !== 'undefined') {
            // Data keys
            var keys = Object.keys(obj.options.data[0]);

            if (keys.length > size) {
                size = keys.length;
            }
        }

        // Minimal dimensions
        if (obj.options.minDimensions[0] > size) {
            size = obj.options.minDimensions[0];
        }

        // Requests
        var multiple = [];

        // Preparations
        for (var i = 0; i < size; i++) {
            // Deprected options. You should use only columns
            if (!obj.options.colHeaders[i]) {
                obj.options.colHeaders[i] = '';
            }
            if (!obj.options.colWidths[i]) {
                obj.options.colWidths[i] = obj.options.defaultColWidth;
            }
            if (!obj.options.colAlignments[i]) {
                obj.options.colAlignments[i] = obj.options.defaultColAlign;
            }

            // Default column description
            if (!obj.options.columns[i]) {
                obj.options.columns[i] = { type: 'text' };
            } else if (!obj.options.columns[i].type) {
                obj.options.columns[i].type = 'text';
            }
            if (!obj.options.columns[i].name) {
                obj.options.columns[i].name = keys && keys[i] ? keys[i] : i;
            }
            if (!obj.options.columns[i].source) {
                obj.options.columns[i].source = [];
            }
            if (!obj.options.columns[i].options) {
                obj.options.columns[i].options = [];
            }
            if (!obj.options.columns[i].editor) {
                obj.options.columns[i].editor = null;
            }
            if (!obj.options.columns[i].allowEmpty) {
                obj.options.columns[i].allowEmpty = false;
            }
            if (!obj.options.columns[i].title) {
                obj.options.columns[i].title = obj.options.colHeaders[i] ? obj.options.colHeaders[i] : '';
            } else {
                obj.headers[i].innerText = obj.options.columns[i].title;
                // Keep the title property
                obj.headers[i].setAttribute('title', obj.options.columns[i].title);
            }
            if (!obj.options.columns[i].width) {
                obj.options.columns[i].width = obj.options.colWidths[i] ? obj.options.colWidths[i] : obj.options.defaultColWidth;
            }
            if (!obj.options.columns[i].align) {
                obj.options.columns[i].align = obj.options.colAlignments[i] ? obj.options.colAlignments[i] : 'center';
            }



        }
    }
    function SetDataTable(dato) {
        console.log(JSON.stringify(dato));
        guid = dato.guid;
        var result = dato.result;
        if (result > 0) alert('Aggiornamento non completato, dati ricaricati perchè lista modificata da altro utente.');
        var data = {
            guid: guid,
        };
        $.getJSON(url, data, function (data) {
            console.log(JSON.stringify(data));
            guid = data.guid;
            rowversions = data.rowversions;
            table.setData(data.data);
            if (data.style)
            table.setStyle(JSON.parse(data.style), null, null, 1, 1);
            // Current column number
            var lastColumn = table.options.columns.length;
            console.log("Ultima colonna tabella:" + lastColumn);
            console.log("Ultima colonna dati:" + data.maxcol);
            if (data.maxcol > lastColumn) {
                for (var i = lastColumn; i < data.maxcol; i++)
                {
                    table.insertColumn(1, parseInt(i), 0);
                }
            }
            if (lastColumn > data.maxcol) {
                for (var i = data.maxcol+1; i <= lastColumn; i++) {
                    table.deleteColumn(1, parseInt(i), 0);
                }
            }
            var confcol = JSON.stringify(data.columns).replace(/sep_deci/g, 'decimal');
   /*         console.log("table.options.columns = "+confcol);*/
            table.options.columns = JSON.parse(confcol);

            updateColonne(table);

        });
    };
