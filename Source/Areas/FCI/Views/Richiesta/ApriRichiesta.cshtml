                                    "Conferma": function () {
                                        var motivazione = $('#imputMotivazione').val();
                                        var motivazioneobbligatoria = self.stato().ObbligoMotivazione;
                                        if (motivazioneobbligatoria && (!motivazione || motivazione.replace(/ /g, '').length <= 5)) {
