                var self = this;
                self.name = name;
                self.width = width;
                self.tipo = ko.observable(initialtipo);

                //self.formattedPrice = ko.computed(function () {
                //    var price = self.tipo().price;
                //    return price ? "$" + price.toFixed(2) : "None";
                //});
            }

