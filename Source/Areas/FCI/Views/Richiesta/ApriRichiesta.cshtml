                                console.log(JSON.stringify(dato));
/*                                self.loggedValues.push(JSON.stringify(dato));*/
                                guid = dato.guid;
                                var result = dato.result;
                                if (result > 0) {
                                    /*self.getDati();*/
                                    alert('Aggiornamento non completato, dati foglio ricaricati perchè modificato da altro utente.');
                                }
                                Gestione(guid);
                            });
                }
                this.getDati = function () {
                    var url = "@Url.Action("getColonne", "Richiesta")";
                    var data = {
                            guid: guid,
                    };
                    $.getJSON(url, data, function (allData) {
                        /*self.NomeLista(allData.NomeLista);*/
                        self.rowversionFoglio = allData.RowVersion;
                        allData.columns.forEach(function (e) {
                            /*console.log("column:" + JSON.stringify(e));*/
                            console.log("column:");
                            console.log("name:"+e.name);
                            console.log("type:" +e.tipo.type);
                            console.log("source:" + e.tipo.source);
                            var tipoavviabile = self.tipoAvviabili.filter(function (x) { return x.type === e.tipo.type })[0];
                            tipoavviabile.source = e.tipo.source;
                            tipoavviabile.numColonna = e.tipo.numColonna;
                            console.log("tipoavviabile:" + JSON.stringify(tipoavviabile));
                            self.colonne.push(new ColonnaConfigurazione(e.name, e.width, tipoavviabile));
                        });
                       /* console.log("allData:" + JSON.stringify(allData));*/
                        /*console.log("Nome lista:" + JSON.stringify(self.NomeLista()));*/
                        console.log("rowversionFoglio:" + JSON.stringify(self.rowversionFoglio));
                    });
                };

                this.getDati();
                //self.totalSurcharge = ko.computed(function () {
                //    var total = 0;
                //    for (var i = 0; i < self.colonne().length; i++)
                //        total += self.colonne()[i].tipo().price;
                //    return total;
                //});

            }

            ko.applyBindings(new AmministrazioneViewModel(), document.getElementById("GestoreColonne"));
                </script>
