    <div id="customAlert" class="" style="display: none"></div>
    <script>
        customAlert = function (message) {
            if (message.length > 0) {
                $("#customAlert").empty();
                console.log("alert:" + message);
                $("<div>").text(message).appendTo("#customAlert");
                $("#customAlert").scrollTop(0);
                var opt = {
                    autoOpen: false,
                    modal: true,
                    width: "auto",
                    height: "auto",
                    title: 'Attenzione!',
                    buttons: {
                        Chiudi: function () {
                            $(this).dialog("close");
                            $(this).dialog("destroy");
                        }
                    },
                };
                $('#customAlert').dialog(opt).dialog('open');
            }
        };
    </script>
