<script>
            function GestioneNuova() {
                var url = '@Url.Action("ApriRichiesta", "Richiesta")';
                dato = {};
                console.log(dato);
                $("#loading").css("display", "block");
                $.ajax({
                url: url,
                data: { istituto: 47, ndg: 12345, codfiscale: "0000000000000" },
                type: "GET",
                    error: function (xhr) {
                        $("#loading").css("display", "none");
                alert('Error: ' + xhr.statusText);
                },
                    success: function (result) {
                        $("#loading").css("display", "none");
                console.log("Popolo div dettaglio");

                $('#dettaglio').html(result);

                }
                });
                }
</script>


