@(Html.Kendo().Grid<vw_Prof_Resource>()
    .Name("GridRunAsIS")
    .Columns(columns =>
               {
                 columns.Bound(o => o.Matricola).ClientTemplate("<input type=\"button\" class=\"gridGotoTask\" onclick=\"return runAsIs(#= CodIstituto #,'#= Matricola #')\"/>").Title("").HtmlAttributes(new { @nowrap = "nowrap" }).Filterable(false);
                 columns.Bound(o => o.CodIstituto);
                 columns.Bound(o => o.Matricola);
                 columns.Bound(o => o.LastName).ClientTemplate("#=data.LastName# #=data.FirstName#").Title("Nominativo");
                 columns.Bound(o => o.MansioneNormalizzata).Title("Mansione");
                 columns.Bound(o => o.DescrizioneUO).Title("Unità org.");




               })
    .DataSource(dataSource => dataSource
                                    .Ajax()
                                    
                                    .Read(read => read.Action("_GridElencoUtentiForRunAsIs", "Richiesta").Data("datagrid"))
        )
    .Resizable(resize => resize.Columns(true))
    .Sortable(sorting => sorting.Enabled(true))
    .Scrollable(scrolling => scrolling.Enabled(false))
    .Pageable(paging => paging.Enabled(true).Messages(m => m
                                                             .Display("{0} - {1} di {2} elementi")
                                                             .Empty("Nessun elemento trovato"))))