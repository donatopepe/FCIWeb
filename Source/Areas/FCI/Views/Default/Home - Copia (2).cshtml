                onmoverow: moveRow,
                onmovecolumn: moveColumn,
                onload: loaded,
                onblur: blur,
                onfocus: focus,
                onpaste: paste,
            });

            jspreadsheet.tabs(document.getElementById('spreadsheet'), sheets);
