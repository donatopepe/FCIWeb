        /**
         * Add new worksheet
         */
        var add = function () {
            var sheets = [];

            sheets.push({
                sheetName: prompt('Create a new tab', 'New tab ' + document.getElementById('spreadsheet').jexcel.length),
                minDimensions: [10, 10],
                columnSorting: true,
                allowComments: true,
                allowInsertColumn: false,
                allowDeleteColumn: false,
                allowRenameColumn: false,
                contextMenu: contextMenu,
                toolbar: toolbar,
                rowResize: true,
