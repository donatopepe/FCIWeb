@using AreaCommonWeb.ModelView.Security

<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="X-UA-Compatible" content="IE=9" />
  <title>@ViewBag.Title</title>

  <link href="@Url.Content("~/Content/style.css?d=" + DateTime.Now.ToString() + "")" rel="stylesheet" type="text/css" />

  <!---------------------------------- kendo ------------------------------->
  <link href="@Url.Content("~/Content/kendo/2015.2.902/kendo.common.min.css")" rel="stylesheet" type="text/css" />
  <link href="@Url.Content("~/Content/kendo/2015.2.902/kendo.dataviz.min.css")" rel="stylesheet" type="text/css" />
  <link href="@Url.Content("~/Content/kendo/2015.2.902/kendo.default.min.css")" rel="stylesheet" type="text/css" />
  <link href="@Url.Content("~/Content/kendo/2015.2.902/kendo.dataviz.default.min.css")" rel="stylesheet" type="text/css" />
  <script src="@Url.Content("~/Scripts/kendo/2015.2.902/jquery.min.js")"></script>
  <script src="@Url.Content("~/Scripts/jquery-ui-1.10.4.min.js")"></script>
  <script src="@Url.Content("~/Scripts/kendo/2015.2.902/kendo.all.min.js")"></script>
  <script src="@Url.Content("~/Scripts/kendo/2015.2.902/kendo.aspnetmvc.min.js")"></script>
  <script src="@Url.Content("~/Scripts/kendo.modernizr.custom.js")"></script>
  <script src="@Url.Content("~/Scripts/Dialog/MessageBoxDialogs.js")" type="text/javascript"></script>
  <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.js")" type="text/javascript"></script>
    <script src="@Url.Content("~/Scripts/pybhelper.js")"></script>

  <script type="text/javascript">
    $(document).ready(function () {

      var browser = $(document).height();
      var header = $("#header").height();
      var menu = $("#menu").height();
      var bottom = $("#bottom").height();
      var footer = $("#footer").height();
      var height = browser - header - menu - bottom - footer - 60;

      $("#containerTop").css("height", height);

    });
  </script>
</head>

<body>
  <span style="display: none" id="appPath">@Request.ApplicationPath</span>
  <!-- # START wrapper -->
  <div id="wrapper">
    <div id="header">
      <div class="logo">
        <img alt="logo" src="@Url.Content("~/Content/img/logo.gif")" width="106" height="57" />
      </div>
      <div class="moduletable-infolog clearfix">
        <text>Salve <strong>@(new UserProfileManager().GetCurrent()!=null ?(new UserProfileManager().GetCurrent().UserInfo.Nome):"")</strong>!</text>
      </div>
    </div>
    <!-- # END wrapper -->

    <!-- # START  CONTAINER -->
    <div id="containerRepeat">
      <div id="containerTop" class="clearfix">
        @RenderBody()
      </div>
      <!-- #END containerTop -->
    </div>
    <!-- #END containerRepeat -->
    <!-- # END  CONTAINER -->


    <!-- #START  BOTTOM -->
    <div id="bottom">
      <div class="moduletable-address">
        <h3>IT Operations</h3>
        Powered by the FCIWeb project
      </div>
      <div class="moduletable-contact">
      </div>
      <div class="moduletable-connect">
        <h3>Informazioni di supporto </h3>

        <a target="_blank" href="http://gruppo.example.it/webapps/redirect.aspx?url=http://portal.example.com/getuserinfo/GetUserInfo.asp?UrlRedirect=http://portal.example.com/Portal/portale/portale.asp">Help Desk</a>

      </div>
    </div>
    <div id="footer">Example &copy; 2014. All rights reserved.</div>
  </div>

</body>

</html>

