
<!-- begin DIV di Lading al caricamento pagina -->
<div id="loading" class="overlay">
    <div id="vert-hoz" >
        <table style="color:#f3f3f3; width:100%">
            <tr>
                <td align="center" style="width:100%;height:100%;">
                    <br />
                    <span>La pagina sta caricando. Attendere prego...</span>
                    <br />
                    <span>Il sistema sta processando le informazioni richieste</span>
                    <br /><br />
                    <img src='@Url.Content("~/Content/img/loading/loading135.gif")' alt='' /> <br />
                </td>
            </tr>
        </table>
    </div> 
</div>

<script type="text/javascript">

    $(document).ready(function () {
        // Handler for .ready() called.
        $("#loading").css("display", "block");
        //alert('document ready');
    });
    $(window).load(function () {
        // run code
        $("#loading").css("display", "none");
        //alert('window load');
    });
    
    
</script>
<!-- end DIV di Lading al caricamento pagina -->
