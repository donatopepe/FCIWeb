  <script src="@Url.Content("~/Scripts/kendo/2015.2.902/kendo.all.min.js")"></script>
  <script src="@Url.Content("~/Scripts/kendo/2015.2.902/kendo.aspnetmvc.min.js")"></script>
  <script src="@Url.Content("~/Scripts/kendo.modernizr.custom.js")"></script>
    <script src="@Url.Content("~/Scripts/kendo/2015.2.902/cultures/kendo.culture.it-IT.min.js")"></script>
  <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.js")" type="text/javascript"></script>
  <script src="@Url.Content("~/Scripts/json2.js")" type="text/javascript"></script>
  <script src="@Url.Content("~/Scripts/Window/gestioneWindow.js")" type="text/javascript"></script>
  <script src="@Url.Content("~/Scripts/tracciatogarante.js")" type="text/javascript"></script>
  <link href="@Url.Content("~/Content/themes/base/jquery.ui.tabs.css")" rel="stylesheet" type="text/css" />
  <link href="@Url.Content("~/Content/themes/base/jquery-ui.css")" rel="stylesheet" type="text/css" />
  <link href="@Url.Content("~/Content/jquery.jgrowl.css")" rel="stylesheet" type="text/css" />
  <script src="@Url.Content("~/Scripts/jquery.blockUI.js")"></script>
  <script src="@Url.Content("~/Scripts/jquery.jgrowl.js")"></script>
  <script src="@Url.Content("~/Scripts/SessionWarning.js")"></script>
    <script src="@Url.Content("~/Scripts/pybhelper.js")"></script>

 <script type="text/javascript">
   //set current culture script
   kendo.culture("it-IT");
  </script>
  <script type="text/javascript">
    //Warning a due minuti dalla scadenza
    var sessionTimeoutWarning = '@System.Configuration.ConfigurationManager.AppSettings["SessionWarning"]';
    //Warning in millisecondi
    var timeWarning = parseInt(sessionTimeoutWarning) * 60 * 1000;
    //Timeout
    var sessionTimeout = '@Session.Timeout';
    //Timeout millisecondi
    var timeTimeout = parseInt(sessionTimeout) * 60 * 1000;
    var timeOnPageLoad = new Date();

    $(document).ready(function () {
      var browser = $(document).height();
      var header = $("#header").height();
      var menu = $("#menu").height();
      var bottom = $("#bottom").height();
      var footer = $("#footer").height();
      var height = browser - header - menu - bottom - footer - 60;

      $("#containerTop").css("height", height);

      //For warning
      var sessionWarningTimer = setTimeout(function () { open(); }, timeWarning);

    });

    function open() {
      //se entro 5 minuti nn sceglie effettuo il logoff
      var autoLogOff = setTimeout(function () { logOff(); }, 240000);
      // setup the dialog
      $("#dialog").dialog({
        autoOpen: true,
        modal: true,
        width: 400,
        height: 200,
        closeOnEscape: false,
        draggable: false,
        resizable: false,
        buttons: {
          'Si, rinnova la sessione': function () {
            $(this).dialog('close');
            clearTimeout(autoLogOff);
            $.ajax({
              url: '@Url.Action("refreshSession", "Helpers",new {area="Common"})'

              });

              setTimeout(function () { open(); }, timeWarning);
            },
            'No, Logoff': function () {
              $(this).dialog('close');
              clearTimeout(autoLogOff);
              logOff();
            }
          }
        });
      }

      function logOff() {
        var appath = GetAppPath();
        var url = "";
        if (appath != "/") {
          url = appath + "/Account/LogOff";
        } else {
          url = "/Account/LogOff";
        }
        window.location = url;
      }
  </script>

</head>

<body>
  <span style="display: none" id="appPath">@Request.ApplicationPath</span>
  <span style="display: none" id="SessionWarning">@System.Configuration.ConfigurationSettings.AppSettings["SessionWarning"]</span>
  <span style="display: none" id="Timeout">@Session.Timeout</span>

  <!-- # START wrapper -->
  <div id="wrapper">
    <div id="header">
      <div class="logo">
        <img alt="logo" src="@Url.Content("~/Content/img/logo.svg")" width="106" height="57" />
      </div>
      <div class="moduletable-infolog clearfix">
        @Html.Partial("_LogOnPartial")
      </div>
    </div>
    <!-- # END wrapper -->

    <!-- # START MENU -->
    <div id="menu">
      @Html.Action("Menu", "Home", new { area = "FCI" })
    </div>
    <!-- # END MENU -->

    <!-- # START  CONTAINER -->
    <div id="containerRepeat">
      <div id="containerTop" class="clearfix">
        <!-- # START BREADCRUMB -->
        <div class="pathway large clearfix">
          @Html.MvcSiteMap().SiteMapPath()
        </div>
        <!-- Include lo script per il loading della pagina -->
        @Html.Partial("_DivLoading")
        @RenderBody()
      </div>
      <!-- #END containerTop -->
    </div>
    <!-- #END containerRepeat -->
    <!-- # END  CONTAINER -->

    <!-- #START  BOTTOM -->
    <div id="bottom">
      <div class="moduletable-address">
        <h3>IT Operations</h3>
        Powered by the FCIWeb project
      </div>
      <div class="moduletable-contact">
      </div>
      <div class="moduletable-connect">
        <h3>Informazioni di supporto </h3>

        <a target="_blank" href="http://portal.example.com/webapps/redirect.aspx?url=http://portal.example.com/getuserinfo/GetUserInfo.asp?UrlRedirect=http://portal.example.com/Portal/portale/portale.asp">Help Desk</a>

      </div>
    </div>
    <div id="footer">Example &copy; 2014. All rights reserved.</div>
  </div>

</body>

</html>


